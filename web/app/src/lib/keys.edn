; agent-desk's built-in keymap, in the evilify skill's shared EDN format
; (evilify/keymap-edn.md). keys.edn next to config.toml on the desk machine
; (normally ~/.config/agent-desk/keys.edn) overlays it: an entry there
; replaces the one here with the same chord, and nil removes it.
; docs/keyboard.md describes the maps, their order and the extensions;
; docs/spec-keymap.md the rules these keys follow.
;
; The commands are defined in keymap.js. A string labels a prefix in the
; key guide. Keys in a pane's map work only while that pane has focus, and
; hide :normal's keys with the same chord.
;
; The scheme, in short: every command has a home in a group (a leader group,
; a vim prefix, or the localleader), and frequent ones a short key too; a
; leader entry reuses its short key's letter (p pins, so SPC b p pins);
; Shift reverses or widens; short keys never do what cannot be undone.
{:normal
 {"SPC"     "leader"
  "SPC b"   "item"
  "SPC d"   "node"
  "SPC h"   "help"
  "SPC i"   "message box"
  "SPC n"   "new"
  "SPC o"   "open"
  "SPC q"   "session"
  "SPC s"   "search"
  "SPC t"   "toggle"
  "SPC w"   "window"
  "SPC x"   "select"
  "g"       "go"
  "y"       "yank"
  "C-w"     "window"

  ; Help and pickers.
  "?"       :cheatsheet
  "SPC ?"   :bindings
  "SPC h b" :bindings
  "SPC h k" :describe-key
  "SPC h f" :describe-command
  ":"       :m-x
  "M-x"     :m-x
  "SPC :"   :m-x
  "SPC SPC" :find
  "SPC ,"   :switch-item
  "f"       :hints
  "SPC j"   :hints
  "/"       :search
  "SPC s s" :search
  "SPC s c" :search-clear
  "ESC"     :escape
  "C-g"     :escape

  ; Moving.
  "n"       :next-open
  "N"       :prev-open
  "J"       :next-item
  "K"       :prev-item
  "C-j"     :next-item
  "C-k"     :prev-item
  "-"       :up

  ; g: go somewhere.
  "g h"     :top
  "g s"     :settings
  "g S"     :settings-global
  "g v"     :verbatim
  "g V"     :verbatim-all
  "g c"     :tasks
  "g C"     :tasks-all
  "g a"     :recordings
  "g r"     :refresh
  "g R"     :reload-page
  "g o"     :open-node
  "g w"     :session
  "g t"     :thread-root

  ; SPC b: the open item (or the selection). Short keys first.
  "a"       :answer
  "t"       :take
  "r"       :message
  "R"       :reply-entry
  "i"       :insert
  "d"       :read
  "U"       :unread
  "p"       :pin
  "x"       :select
  "SPC b a" :answer
  "SPC b t" :take
  "SPC b r" :message
  "SPC b R" :reply-entry
  "SPC b d" :read
  "SPC b u" :unread
  "SPC b p" :pin
  "SPC b x" :select
  "SPC b n" :next-open
  "SPC b N" :prev-open
  "SPC b b" :switch-item
  "SPC b o" :open-node
  "SPC b w" :session
  "SPC b e" :org-export-item

  ; SPC i: the message box.
  "SPC i i" :insert
  "SPC i f" :attach
  "SPC i v" :voice-toggle
  "SPC i r" :voice-recordings
  "SPC i n" :notify-menu
  "SPC i s" :send-menu
  "SPC i x" :draft-discard
  "SPC i c" :reply-to-cancel

  ; SPC n: new.
  "c"       :task-add
  "SPC n t" :task-add
  "SPC n m" :node-message
  "SPC n v" :node-velocity

  ; SPC d: the node shown.
  "SPC d f" :go-node
  "SPC d u" :up
  "SPC d h" :top
  "SPC d d" :node-read-all
  "SPC d s" :node-settings
  "SPC d a" :agent-archive
  "SPC d e" :org-export-node
  "SPC d i" :org-export-inbox

  ; SPC o: open a page.
  "SPC o s" :settings
  "SPC o S" :settings-global
  "SPC o v" :verbatim
  "SPC o V" :verbatim-all
  "SPC o t" :tasks
  "SPC o T" :tasks-all
  "SPC o r" :recordings
  "SPC o o" :section-order
  "SPC o f" :edit-sets

  ; SPC q: the session.
  "SPC q r" :reload-page
  "SPC q s" :screen-release

  ; SPC t: toggles.
  "SPC t a" :toggle-all
  "SPC t o" :toggle-old
  "SPC t d" :deliverables-show
  "SPC t t" :tasks-show
  "SPC t s" :toggle-select
  "SPC t c" :toggle-auto-continue

  ; SPC w and C-w: panes.
  "SPC w h" :pane-left
  "SPC w l" :pane-right
  "SPC w w" :pane-next
  "SPC w s" :pane-side
  "SPC w d" :pane-detail
  "C-w h"   :pane-left
  "C-w l"   :pane-right
  "C-w w"   :pane-next

  ; y: everything copyable.
  "y y"     :yank-link
  "y i"     :yank-id
  "y r"     :yank-resume
  "y a"     :yank-paseo
  "y p"     :yank-path
  "y f"     :yank-hint
  "y q"     :quota-copy-ids
  "y l"     :push-logs
  "y b"     :push-brave-setting

  ; SPC x: selecting.
  "V"       :visual
  "v"       :visual
  "SPC x a" :select-all
  "SPC x c" :select-clear
  "SPC x d" :list-read-all}

 :list
 {"z"       "fold"
  "j"       :next-item
  "k"       :prev-item
  "<down>"  :next-item
  "<up>"    :prev-item
  "g g"     :first-item
  "G"       :last-item
  "}"       :next-section
  "{"       :prev-section
  "z a"     :fold
  "z c"     :fold-close
  "z o"     :fold-open
  "z M"     :fold-all
  "z R"     :unfold-all
  "C-d"     :list-half-down
  "C-u"     :list-half-up
  "RET"     :read-in-detail
  "l"       :read-in-detail
  "o"       :read-in-detail
  "h"       :pane-side}

 :detail
 {"j"       :scroll-down
  "k"       :scroll-up
  "<down>"  :scroll-down
  "<up>"    :scroll-up
  "C-d"     :half-down
  "C-u"     :half-up
  "C-f"     :page-down
  "C-b"     :page-up
  "g g"     :scroll-top
  "G"       :scroll-bottom
  "h"       :back-to-list
  "q"       :close}

 :side
 {"j"       :side-next
  "k"       :side-prev
  "<down>"  :side-next
  "<up>"    :side-prev
  "g g"     :side-first
  "G"       :side-last
  "l"       :side-open
  "o"       :side-open
  "RET"     :side-open}

 ; While a sheet is open, only these keys work.
 :dialog
 {"j"       :sheet-next
  "k"       :sheet-prev
  "C-n"     :sheet-next
  "C-p"     :sheet-prev
  "<down>"  :sheet-next
  "<up>"    :sheet-prev
  "g g"     :sheet-first
  "G"       :sheet-last
  "C-g"     :sheet-close
  "q"       :sheet-close
  "?"       :cheatsheet
  ":"       :m-x
  "M-x"     :m-x
  "f"       :hints}

 ; Inside a text box. ESC, C-g and C-[ always leave it.
 :insert
 {"M-x"     :m-x}

 ; The context maps hold the keys typed after the localleader (, or SPC m):
 ; what only the open thing has. The same letter means the same idea across
 ; them: o opens, r retries or replaces, y and n say yes and no.
 :localleader ["," "SPC m"]

 :task
 {"s"       :task-status
  "o"       :task-reopen
  "d"       :task-done
  "D"       :task-drop
  "z"       :task-defer
  "Z"       :task-defer-quota
  "u"       :task-undefer
  "l"       :task-start}

 :deliverable
 {"o"       :deliverable-open
  "g"       :deliverable-download
  "w"       :deliverable-works}

 ; A question asking for the screen.
 :screen
 {"y"       :screen-grant
  "n"       :screen-deny}

 ; A message that failed to deliver, or whose recording failed to transcribe.
 :message
 {"r"       :deliver-retry
  "t"       :voice-retry
  "s"       :voice-omit}

 ; While focus is in the Out of quota section.
 :quota
 {"a"       :quota-archive
  "r"       :quota-replace
  "d"       :quota-dismiss
  "p"       :quota-ask-parent
  "y"       :quota-copy-ids}

 :settings
 {"o"       :section-order
  "O"       :section-order-reset
  "r"       :org-render
  "e"       :org-export
  "E"       :org-export-zip
  "p"       :push-toggle
  "t"       :push-test
  "l"       :push-logs
  "b"       :push-brave-setting}

 :verbatim
 {"m"       :verbatim-more}

 ; No key, on purpose (SPC h f says so; M-x still runs them). A test fails
 ; on any other command without a key, and on any button with neither a
 ; command (data-cmd) nor data-keys="none".
 :keyless [:deliverables-unread :deliverables-latest :deliverables-all ; SPC t d cycles them
           :compose                                 ; i does it, and returns to the box Esc left
           :deferred-launch :deferred-launch-top]}  ; they start agents: by name only
