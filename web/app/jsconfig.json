{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "checkJs": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.svelte",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/**/*.test.js"
  ]
}
